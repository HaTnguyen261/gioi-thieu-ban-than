   4. GRAB BALL ANIMATION
===================================== */

function grabBall() {
  if (gameBusy) return;

  if (hasAnsweredCorrectly) {
    nextQuestion();
    return;
  }

  gameBusy = true;
  grabButton.disabled = true;
  grabButton.textContent = "GRABBING...";
  gameStatus.textContent = "The claw is reaching for a mystery ball...";

  claw.classList.add("down");

  setTimeout(() => {
    ballPile.style.opacity = ".35";

    setTimeout(() => {
      claw.classList.remove("down");

      setTimeout(() => {
        ballPile.style.opacity = "1";
        gameBusy = false;
        grabButton.disabled = false;
        openQuestion();
      }, 750);
    }, 300);
  }, 700);
}

