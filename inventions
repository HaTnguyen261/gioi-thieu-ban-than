<script>
/* =====================================
   1. PRESENTATION NAVIGATION
===================================== */

const slides = [...document.querySelectorAll(".slide")];
const dotsContainer = document.getElementById("dots");
const progressFill = document.getElementById("progressFill");
const slideNumber = document.getElementById("slideNumber");

let activeSlide = 0;

slides.forEach((slide, index) => {
  const dot = document.createElement("button");
  dot.className = "dot" + (index === 0 ? " active" : "");
  dot.setAttribute("aria-label", "Go to slide " + (index + 1));
  dot.addEventListener("click", () => goTo(index));
  dotsContainer.appendChild(dot);
});

function goTo(index) {
  if (index < 0 || index >= slides.length) return;

  slides[activeSlide].classList.remove("active");
  dotsContainer.children[activeSlide].classList.remove("active");

  activeSlide = index;

  slides[activeSlide].classList.add("active");
  dotsContainer.children[activeSlide].classList.add("active");

  slideNumber.textContent = String(index + 1).padStart(2, "0");
  progressFill.style.width = ((index + 1) / slides.length * 100) + "%";
}

function nextSlide() {
  if (activeSlide < slides.length - 1) goTo(activeSlide + 1);
}

function previousSlide() {
  if (activeSlide > 0) goTo(activeSlide - 1);
}

function toggleFullscreen() {
  if (!document.fullscreenElement) {
    document.documentElement.requestFullscreen?.();
  } else {
    document.exitFullscreen?.();
  }
}

document.addEventListener("keydown", (event) => {
  const modalOpen =
    document.getElementById("questionModal").classList.contains("show") ||
    document.getElementById("resultModal").classList.contains("show");

  if (modalOpen) {
    if (event.key === "Escape") {
      closeQuestion();
    }
    return;
  }

  if (event.key === "ArrowRight" || event.key === " ") nextSlide();
  if (event.key === "ArrowLeft") previousSlide();
});

/* =====================================
   2. QUESTION DATABASE
===================================== */

