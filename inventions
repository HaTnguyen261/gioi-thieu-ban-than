  feedback.classList.remove("show");
  feedback.textContent = "";

  document.getElementById("nextButton").style.display = "none";
  questionModal.classList.add("show");
}

/* =====================================
   6. CHECK ANSWER AND UPDATE SCORE
===================================== */

function checkAnswer(selectedIndex, selectedButton) {
  if (hasAnsweredCorrectly) return;

  const question = questions[questionIndex];
  const feedback = document.getElementById("feedback");
  const allButtons = document.querySelectorAll(".answer-option");

  if (selectedIndex === question.correct) {
    hasAnsweredCorrectly = true;

    const earnedPoints = randomPoint([0, 10, 20, 30]);
    score += earnedPoints;
    updateScore();

    selectedButton.classList.add("correct");
    allButtons.forEach(button => button.disabled = true);

    feedback.innerHTML =
      "<strong>🎉 CORRECT ANSWER!</strong><br>" +
      question.explanation +
      "<br><br><strong>+" + earnedPoints + " points!</strong>";

    feedback.classList.add("show");

    document.getElementById("nextButton").style.display = "block";
    document.getElementById("nextButton").textContent =
      questionIndex === questions.length - 1
        ? "SEE MY RESULT →"
        : "NEXT BALL →";

    gameStatus.textContent = "Correct! You can continue to the next ball.";
    grabButton.textContent = "NEXT BALL →";

  } else {
    const lostPoints = randomPoint([0, 5, 10, 15]);
    score = Math.max(0, score - lostPoints);
    updateScore();

    selectedButton.classList.add("wrong");
    selectedButton.disabled = true;

    feedback.innerHTML =
      "<strong>❌ NOT QUITE! TRY AGAIN.</strong><br>" +
      "You lost " + lostPoints + " points.<br>" +
      "Current score: " + score + " points.<br><br>" +
      "Think carefully and choose another answer!";

    feedback.classList.add("show");

    // The same question stays open until the correct answer is selected.
  }
}

/* =====================================
   7. NEXT QUESTION
===================================== */

function nextQuestion() {
  if (!hasAnsweredCorrectly) return;

  questionModal.classList.remove("show");

  questionIndex++;

  if (questionIndex >= questions.length) {
    showResult();
    return;
  }

  hasAnsweredCorrectly = false;
  grabButton.disabled = false;
  grabButton.textContent = "GRAB ANOTHER BALL!";
  gameStatus.textContent = "Ready for the next mystery ball?";
}

/* =====================================
   8. CLOSE AND REOPEN QUESTION
===================================== */

function closeQuestion() {
  questionModal.classList.remove("show");

  if (hasAnsweredCorrectly) {
    grabButton.disabled = false;
    grabButton.textContent = "NEXT BALL →";
    gameStatus.textContent = "Your answer is correct. Continue when ready.";
  } else {
    grabButton.disabled = false;
    grabButton.textContent = "OPEN QUESTION";
    gameStatus.textContent = "Your current question is waiting for you.";
  }
}

grabButton.addEventListener("click", () => {
  if (
    !gameBusy &&
    !questionModal.classList.contains("show") &&
    !resultModal.classList.contains("show") &&
    !hasAnsweredCorrectly &&
    grabButton.textContent === "OPEN QUESTION"
  ) {
    openQuestion();
  }
});

/* =====================================
   9. FINAL RESULT
===================================== */

function showResult() {
  gameBusy = false;

  document.getElementById("finalScore").textContent = score + " PTS";

  let message = "Good effort! Keep exploring the world of inventions.";

  if (score >= 150) {
    message = "Outstanding! You are a true Inventions Expert!";
  } else if (score >= 90) {
    message = "Excellent work! You know a lot about technology!";
  } else if (score >= 40) {
    message = "Great job! Keep learning and discovering new things!";
  }

  document.getElementById("resultMessage").textContent = message;
  resultModal.classList.add("show");
}

/* =====================================
   10. RESTART GAME
===================================== */

function restartGame() {
  score = 0;
  questionIndex = 0;
  hasAnsweredCorrectly = false;
  gameBusy = false;

  updateScore();

  claw.classList.remove("down");
  ballPile.style.opacity = "1";

  grabButton.disabled = false;
  grabButton.textContent = "GRAB A BALL!";
  gameStatus.textContent = "A new challenge is waiting for you!";

  questionModal.classList.remove("show");
  resultModal.classList.remove("show");
}

// Initialize presentation
goTo(0);
</script>
