
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>INNOVATIONS | English 10 - Unit 5</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
:root {
  --navy: #07142e;
  --navy2: #0b2148;
  --blue: #1769ff;
  --blue2: #398cff;
  --cyan: #43dcff;
  --purple: #9874ff;
  --white: #ffffff;
  --ice: #f1f7ff;
  --text: #12264a;
  --muted: #71809a;
  --line: #dce8f8;
  --green: #21c997;
  --orange: #ffb547;
  --pink: #ff6fae;
  --shadow: 0 22px 60px rgba(10, 45, 105, .13);
}

* { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; }

body {
  font-family: 'DM Sans', sans-serif;
  background: var(--navy);
  color: var(--text);
  overflow: hidden;
}

button { font-family: inherit; cursor: pointer; }

button:focus-visible {
  outline: 3px solid var(--cyan);
  outline-offset: 4px;
}

.presentation {
  width: 100%;
  height: 100dvh;
  position: relative;
  overflow: hidden;
  background: var(--ice);
}

/* TOP PROGRESS */

.top-progress {
  height: 5px;
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: rgba(255,255,255,.2);
}

.progress-fill {
  height: 100%;
  width: 12.5%;
  background: linear-gradient(90deg, var(--blue), var(--cyan), var(--purple));
  box-shadow: 0 0 18px var(--cyan);
  transition: width .55s ease;
}

/* BACKGROUND DECORATION */

.slide {
  position: absolute;
  inset: 0;
  padding: 75px 8% 105px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  overflow-y: auto;
  opacity: 0;
  visibility: hidden;
  transform: translateX(45px) scale(.985);
  transition: opacity .55s ease, transform .55s ease, visibility .55s;
  background:
    radial-gradient(circle at 90% 8%, rgba(56,145,255,.13), transparent 25%),
    radial-gradient(circle at 4% 95%, rgba(152,116,255,.09), transparent 28%),
    linear-gradient(135deg, #f8fbff, #edf5ff);
}

.slide.active {
  opacity: 1;
  visibility: visible;
  transform: translateX(0) scale(1);
}

.slide.dark {
  color: white;
  background:
    radial-gradient(circle at 85% 15%, rgba(67,220,255,.2), transparent 28%),
    radial-gradient(circle at 10% 90%, rgba(152,116,255,.2), transparent 30%),
    linear-gradient(130deg, #06142e, #0b2d65 65%, #104f9d);
}

.slide.dark::before,
.slide.dark::after {
  content: "";
  position: absolute;
  border: 1px solid rgba(100,190,255,.12);
  border-radius: 50%;
  pointer-events: none;
}

.slide.dark::before {
  width: 420px;
  height: 420px;
  right: -170px;
  top: -190px;
}

.slide.dark::after {
  width: 300px;
  height: 300px;
  left: -180px;
  bottom: -170px;
}

/* TYPOGRAPHY */

.eyebrow {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--blue);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  margin-bottom: 17px;
}

.eyebrow::before {
  content: "";
  width: 25px;
  height: 3px;
  border-radius: 20px;
  background: currentColor;
}

.dark .eyebrow { color: var(--cyan); }

h1, h2, h3, h4 {
  font-family: 'Space Grotesk', sans-serif;
  line-height: 1.15;
}

h1 {
  font-size: clamp(48px, 8vw, 100px);
  font-weight: 700;
  letter-spacing: -5px;
}

h2 {
  font-size: clamp(31px, 4.8vw, 56px);
  letter-spacing: -2px;
  margin-bottom: 15px;
}

h3 { font-size: 20px; margin-bottom: 9px; }

p {
  color: var(--muted);
  font-size: 14px;
  line-height: 1.8;
}

.dark p { color: #c7d9f4; }

.gradient-text {
  background: linear-gradient(100deg, #4aa5ff, #54e4ff, #a98aff);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.lead {
  max-width: 690px;
  font-size: 16px;
  line-height: 1.9;
}

.small-label {
  color: #8ca2c1;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 2px;
}

/* BUTTONS */

.btn {
  border: 0;
  border-radius: 12px;
  padding: 14px 22px;
  font-weight: 800;
  font-size: 13px;
  transition: .25s;
}

.btn:hover { transform: translateY(-3px); }

.btn-primary {
  color: white;
  background: linear-gradient(110deg, #1769ff, #399dff);
  box-shadow: 0 10px 25px rgba(23,105,255,.27);
}

.btn-glass {
  color: white;
  background: rgba(255,255,255,.1);
  border: 1px solid rgba(255,255,255,.25);
}

.btn-light {
  background: white;
  color: var(--blue);
  border: 1px solid var(--line);
}

.button-row {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 27px;
}

/* COVER */

.cover-layout {
  display: grid;
  grid-template-columns: 1.15fr .85fr;
  gap: 25px;
  align-items: center;
  position: relative;
  z-index: 2;
}

.unit-tag {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  color: #a8dcff;
  border: 1px solid rgba(91,193,255,.4);
  background: rgba(39,131,255,.12);
  padding: 9px 14px;
  border-radius: 30px;
  font-size: 10px;
  letter-spacing: 2px;
  font-weight: 800;
  margin-bottom: 26px;
}

.cover-title { max-width: 720px; }

.cover-description {
  font-size: 17px;
  max-width: 510px;
  margin-top: 22px;
}

.cover-meta {
  margin-top: 35px;
  display: flex;
  align-items: center;
  gap: 15px;
  color: #a8c3e9;
  font-size: 11px;
  letter-spacing: 1px;
}

.meta-line {
  width: 35px;
  height: 1px;
  background: var(--cyan);
}

.hero-visual {
  min-height: 380px;
  display: grid;
  place-items: center;
  position: relative;
}

.hero-circle {
  width: min(330px, 75vw);
  aspect-ratio: 1;
  border-radius: 50%;
  border: 1px solid rgba(75,202,255,.5);
  display: grid;
  place-items: center;
  position: relative;
  animation: orbit 25s linear infinite;
  box-shadow: 0 0 80px rgba(43,159,255,.12);
}

.hero-circle::before,
.hero-circle::after {
  content: "";
  position: absolute;
  border: 1px solid rgba(75,202,255,.25);
  border-radius: 50%;
}

.hero-circle::before { inset: 30px; }
.hero-circle::after { inset: 70px; }

.hero-core {
  font-size: 125px;
  filter: drop-shadow(0 20px 35px rgba(0,0,0,.25));
  animation: float 4s ease-in-out infinite;
}

.orbit-icon {
  position: absolute;
  font-size: 32px;
  animation: counter 25s linear infinite;
}

.orbit-icon.one { top: 4%; left: 45%; }
.orbit-icon.two { right: 2%; bottom: 30%; }
.orbit-icon.three { left: 3%; bottom: 25%; }

.glow-dot {
  position: absolute;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--cyan);
  box-shadow: 0 0 20px var(--cyan);
}

@keyframes orbit { to { transform: rotate(360deg); } }
@keyframes counter { to { transform: rotate(-360deg); } }
@keyframes float {
  0%,100% { transform: translateY(0); }
  50% { transform: translateY(-18px); }
}

/* COMMON CARDS */

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 20px;
  margin-bottom: 24px;
}

.section-number {
  font-family: 'Space Grotesk';
  font-size: 13px;
  color: #91a5c1;
  font-weight: 700;
}

.cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 17px;
  margin-top: 22px;
}

.card {
  position: relative;
  overflow: hidden;
  padding: 23px;
  background: rgba(255,255,255,.92);
  border: 1px solid #dce9fa;
  border-radius: 20px;
  box-shadow: 0 10px 30px rgba(19,68,130,.06);
  transition: transform .3s, box-shadow .3s, border .3s;
  animation: appear .65s both;
}

.card:nth-child(2) { animation-delay: .08s; }
.card:nth-child(3) { animation-delay: .16s; }
.card:nth-child(4) { animation-delay: .22s; }
.card:nth-child(5) { animation-delay: .28s; }
.card:nth-child(6) { animation-delay: .34s; }

.card:hover {
  transform: translateY(-7px);
  box-shadow: var(--shadow);
  border-color: #8acbff;
}

.card::after {
  content: "";
  position: absolute;
  width: 110px;
  height: 110px;
  border-radius: 50%;
  background: rgba(43,141,255,.06);
  right: -45px;
  bottom: -55px;
}

.card-icon {
  width: 54px;
  height: 54px;
  display: grid;
  place-items: center;
  border-radius: 16px;
  font-size: 27px;
  margin-bottom: 17px;
  background: #e8f2ff;
}

.card h3 { color: #122d59; font-size: 18px; }
.card p { font-size: 12px; }

.card-blue .card-icon { background: #e5efff; }
.card-purple .card-icon { background: #f0eaff; }
.card-green .card-icon { background: #e3faf2; }
.card-orange .card-icon { background: #fff3df; }
.card-pink .card-icon { background: #ffeaf2; }

@keyframes appear {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

/* INTRODUCTION */

.definition-layout {
  display: grid;
  grid-template-columns: 1fr .85fr;
  gap: 25px;
  align-items: stretch;
}

.definition-panel {
  padding: 30px;
  border-radius: 23px;
  color: white;
  background: linear-gradient(140deg, #0a2a62, #1769ff 75%, #3a9cff);
  box-shadow: 0 20px 45px rgba(23,105,255,.2);
  position: relative;
  overflow: hidden;
}

.definition-panel::after {
  content: "IDEA";
  position: absolute;
  right: -15px;
  bottom: -30px;
  font-family: 'Space Grotesk';
  font-weight: 700;
  font-size: 90px;
  color: rgba(255,255,255,.08);
}

.definition-panel p { color: #d8eaff; }
.definition-panel h3 { font-size: 25px; margin: 18px 0; }

.definition-icon {
  font-size: 50px;
  display: inline-block;
}

.info-stack {
  display: grid;
  gap: 12px;
}

.info-item {
  padding: 17px;
  display: flex;
  gap: 13px;
  align-items: center;
  background: white;
  border: 1px solid var(--line);
  border-radius: 15px;
}

.info-item .emoji { font-size: 27px; }
.info-item h3 { font-size: 15px; margin: 0 0 4px; }
.info-item p { font-size: 11px; }

/* HISTORY / TIMELINE */

.timeline {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 13px;
  margin-top: 30px;
  position: relative;
}

.timeline-item {
  position: relative;
  padding: 22px 17px;
  background: white;
  border: 1px solid var(--line);
  border-radius: 17px;
  min-height: 170px;
  box-shadow: 0 8px 22px rgba(19,68,130,.05);
}

.timeline-year {
  font-family: 'Space Grotesk';
  font-size: 23px;
  font-weight: 700;
  color: var(--blue);
  margin-bottom: 12px;
}

.timeline-item h3 { font-size: 15px; }
.timeline-item p { font-size: 11px; }

/* EVERYDAY LIFE */

.life-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  margin-top: 22px;
}

.life-feature {
  min-height: 330px;
  padding: 28px;
  border-radius: 24px;
  color: white;
  background:
    radial-gradient(circle at 80% 15%, rgba(255,255,255,.2), transparent 30%),
    linear-gradient(140deg, #0a2b65, #1769ff, #3c9dff);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
  position: relative;
}

.life-feature p { color: #d8eaff; }
.life-feature .big-emoji {
  font-size: 95px;
  text-align: right;
  filter: drop-shadow(0 10px 20px rgba(0,0,0,.15));
}

.life-list { display: grid; gap: 11px; }

.life-row {
  display: flex;
  gap: 14px;
  align-items: center;
  background: white;
  border: 1px solid var(--line);
  padding: 14px;
  border-radius: 15px;
}

.life-row .emoji { font-size: 28px; }
.life-row h3 { font-size: 15px; margin: 0 0 3px; }
.life-row p { font-size: 11px; }

/* BENEFITS */

.pros-cons {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
  margin-top: 23px;
}

.pros-panel, .cons-panel {
  padding: 24px;
  border-radius: 22px;
  background: white;
  border: 1px solid var(--line);
}

.pros-panel { border-top: 5px solid var(--green); }
.cons-panel { border-top: 5px solid var(--pink); }

.panel-heading {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 17px;
}

.panel-heading span { font-size: 28px; }
.panel-heading h3 { margin: 0; }

.point {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 10px 0;
  border-bottom: 1px solid #edf2f8;
}

.point:last-child { border: 0; }
.point .mark { font-weight: 900; color: var(--green); }
.cons-panel .mark { color: #f16c90; }
.point p { font-size: 12px; color: #536780; }

/* FUTURE */

.future-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 17px;
  margin-top: 26px;
}

.future-card {
  padding: 24px;
  min-height: 210px;
  border-radius: 20px;
  border: 1px solid rgba(131,194,255,.22);
  background: rgba(255,255,255,.08);
  backdrop-filter: blur(10px);
  transition: .3s;
}

.future-card:hover {
  transform: translateY(-7px);
  background: rgba(255,255,255,.14);
}

.future-card .icon { font-size: 43px; margin-bottom: 18px; }
.future-card h3 { color: white; }
.future-card p { font-size: 12px; }

.future-note {
  margin-top: 25px;
  padding: 18px 22px;
  border-radius: 16px;
  border: 1px solid rgba(82,212,255,.3);
  background: rgba(44,156,255,.12);
  color: #d9f1ff;
  font-size: 13px;
}

/* CONCLUSION */

.conclusion-layout {
  display: grid;
  grid-template-columns: 1.1fr .9fr;
  gap: 30px;
  align-items: center;
}

.takeaways {
  display: grid;
  gap: 12px;
  margin-top: 22px;
}

.takeaway {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 13px 15px;
  border-radius: 13px;
  background: white;
  border: 1px solid var(--line);
}

.takeaway .check {
  width: 27px;
  height: 27px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: #e2f8f0;
  color: #119c6c;
  font-weight: 900;
}

.takeaway p { font-size: 12px; font-weight: 700; color: #345071; }

.thank-card {
  padding: 30px;
  min-height: 310px;
  border-radius: 25px;
  background: linear-gradient(145deg, #0a2b65, #1769ff, #7b70ff);
  color: white;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-shadow: 0 20px 45px rgba(23,105,255,.2);
}

.thank-card p { color: #dceaff; }
.thank-emoji { font-size: 75px; text-align: right; }

/* GAME */

.game-slide {
  align-items: center;
  text-align: center;
}

.game-intro { max-width: 720px; }

.game-machine {
  width: min(420px, 95%);
  padding: 17px;
  margin-top: 20px;
  border-radius: 24px;
  background: linear-gradient(145deg, #245bb2, #091b46);
  border: 2px solid #61baff;
  box-shadow: 0 20px 60px rgba(0,0,0,.3), 0 0 35px rgba(57,157,255,.2);
}

.machine-title {
  color: #a5eaff;
  letter-spacing: 3px;
  font-size: 12px;
  font-weight: 900;
  margin-bottom: 13px;
}

.machine-window {
  height: 145px;
  border: 5px solid #9ddcff;
  border-radius: 14px;
  background: linear-gradient(160deg, #d7f5ff, #85cfff);
  position: relative;
  overflow: hidden;
  box-shadow: inset 0 0 25px rgba(30,110,190,.2);
}

.machine-window::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(120deg, rgba(255,255,255,.5), transparent 45%);
  pointer-events: none;
}

.claw {
  position: absolute;
  z-index: 2;
  top: -4px;
  left: 50%;
  transform: translateX(-50%);
  font-size: 42px;
  transition: top .8s cubic-bezier(.2,.8,.3,1);
}

.claw.down { top: 62px; }

.ball-pile {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 6px;
  display: flex;
  justify-content: space-around;
  font-size: 31px;
  transition: opacity .3s;
}

.machine-score {
  color: white;
  margin: 15px 0;
  font-family: 'Space Grotesk';
  font-weight: 700;
  letter-spacing: 1px;
}

.machine-score strong { color: var(--cyan); font-size: 25px; }

.grab-button {
  border: 0;
  border-radius: 30px;
  padding: 13px 27px;
  color: #08234d;
  background: linear-gradient(100deg, #54e1ff, #a5efff);
  font-weight: 900;
  letter-spacing: 1px;
  box-shadow: 0 7px 20px rgba(67,220,255,.2);
  transition: .2s;
}

.grab-button:hover { transform: scale(1.05); }
.grab-button:disabled { opacity: .6; cursor: wait; }

.game-status {
  color: #b8d9ff;
  font-size: 11px;
  margin-top: 11px;
}

/* NAVIGATION */

.navigation {
  height: 70px;
  position: absolute;
  z-index: 40;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 5%;
  background: rgba(255,255,255,.93);
  border-top: 1px solid #dce8f8;
  backdrop-filter: blur(15px);
}

.nav-group { display: flex; align-items: center; gap: 11px; }

.nav-button {
  width: 39px;
  height: 39px;
  border-radius: 11px;
  border: 1px solid #d7e5f7;
  color: #225a9f;
  background: white;
  font-size: 18px;
  transition: .2s;
}

.nav-button:hover { background: var(--blue); color: white; }

.counter {
  font-family: 'Space Grotesk';
  font-size: 12px;
  font-weight: 700;
  color: #59718f;
}

.dots { display: flex; gap: 6px; }

.dot {
  width: 7px;
  height: 7px;
  border-radius: 10px;
  background: #cbd9eb;
  cursor: pointer;
  transition: .25s;
}

.dot.active { width: 22px; background: var(--blue); }

.fullscreen-button {
  border: 0;
  background: #eaf3ff;
  color: #1b559c;
  padding: 10px 13px;
  border-radius: 10px;
  font-size: 11px;
  font-weight: 800;
}

/* GAME MODALS */

.modal {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 100;
  padding: 18px;
  background: rgba(3,12,32,.82);
  backdrop-filter: blur(10px);
  place-items: center;
}

.modal.show { display: grid; }

.question-card {
  width: min(540px, 100%);
  padding: 28px;
  border-radius: 24px;
  background: white;
  box-shadow: 0 25px 80px rgba(0,0,0,.3);
  animation: appear .3s;
}

.question-top {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 17px;
}

.question-tag {
  color: var(--blue);
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 1.5px;
}

.question-progress {
  color: #8193ad;
  font-size: 11px;
  font-weight: 700;
}

.question-card h3 {
  color: #132b53;
  font-size: 21px;
  line-height: 1.4;
  margin-bottom: 18px;
}

.answer-list { display: grid; gap: 9px; }

.answer-option {
  padding: 13px 15px;
  border-radius: 12px;
  text-align: left;
  border: 1px solid #dce8f8;
  color: #294566;
  background: #f6f9ff;
  font-size: 13px;
  font-weight: 700;
  transition: .2s;
}

.answer-option:hover:not(:disabled) {
  border-color: var(--blue);
  background: #eaf3ff;
  transform: translateX(3px);
}

.answer-option:disabled { cursor: default; }
.answer-option.correct { background: #e3faf1; border-color: #37c792; color: #12875e; }
.answer-option.wrong { background: #fff0f1; border-color: #ff8799; color: #bb405a; }

.feedback {
  display: none;
  padding: 13px;
  border-radius: 12px;
  margin-top: 14px;
  background: #edf5ff;
  color: #315781;
  font-size: 12px;
  line-height: 1.7;
}

.feedback.show { display: block; }

.modal-actions {
  display: flex;
  gap: 10px;
